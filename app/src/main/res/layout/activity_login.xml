<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_screen"
    android:padding="24dp">

    <!-- App Logo / Branding -->
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_verified_shield"
        app:tint="@color/color_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Balod Services"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/color_primary"
        app:layout_constraintTop_toBottomOf="@id/iv_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="लॉगिन करें और सेवाएं खोजें"
        android:textSize="16sp"
        android:textColor="@color/color_text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Phone Number Input Section -->
    <LinearLayout
        android:id="@+id/layout_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
        android:layout_marginTop="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="अपना मोबाइल नंबर दर्ज करें"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+91"
                android:textColor="@color/color_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="@color/color_divider"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp" />

            <EditText
                android:id="@+id/et_phone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="9876543210"
                android:textColorHint="@color/color_text_hint"
                android:textColor="@color/color_text_primary"
                android:textSize="16sp"
                android:inputType="phone"
                android:maxLength="10" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send_otp"
            style="@style/Widget.BalodSeva.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="OTP भेजें"
            android:layout_marginTop="24dp" />
    </LinearLayout>

    <!-- OTP Input Section (Hidden by default) -->
    <LinearLayout
        android:id="@+id/layout_otp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
        android:layout_marginTop="40dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OTP दर्ज करें"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <EditText
                android:id="@+id/et_otp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="123456"
                android:textColorHint="@color/color_text_hint"
                android:textColor="@color/color_text_primary"
                android:textSize="18sp"
                android:letterSpacing="0.2"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="6" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_verify_otp"
            style="@style/Widget.BalodSeva.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="सत्यापित करें"
            android:layout_marginTop="24dp" />
            
        <TextView
            android:id="@+id/tv_resend_otp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OTP दोबारा भेजें"
            android:textColor="@color/color_primary"
            android:textSize="14sp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/layout_phone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
