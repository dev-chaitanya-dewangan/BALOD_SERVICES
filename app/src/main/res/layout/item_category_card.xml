<?xml version="1.0" encoding="utf-8"?>
<!-- ITEM: Category Card — matches the category rows in Screen 2 -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Category Icon Circle -->
        <FrameLayout
            android:id="@+id/fl_icon_bg"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_avatar_circle">

            <ImageView
                android:id="@+id/iv_category_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_services"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Text Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tv_category_name_hindi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="प्लंबर"
                android:textColor="@color/color_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_category_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="नल, पाइप, टंकी आदि की\nमरम्मत और फिटिंग"
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="3dp"
                android:lineSpacingExtra="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_see_service"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="10dp"
                android:text="@string/see_service"
                android:textSize="11sp"
                android:textColor="@color/color_primary"
                app:backgroundTint="@color/color_primary_container"
                app:cornerRadius="15dp"
                app:strokeColor="@color/transparent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- Right: Worker Image Preview -->
        <ImageView
            android:id="@+id/iv_category_worker"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_worker_hero"
            android:contentDescription="@null"
            android:layout_marginStart="8dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
