<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BalodSeva" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/color_whatsapp</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/color_bg_card</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="android:colorBackground">@color/color_bg_screen</item>
        <item name="colorOnBackground">@color/color_text_primary</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Typography -->
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.BalodSeva" parent="TextAppearance.Material3.BodyLarge"/>

    <!-- Button Styles -->
    <style name="Widget.BalodSeva.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/color_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.BalodSeva.Button.WhatsApp" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/color_whatsapp</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.BalodSeva.Button.Call" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/color_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.BalodSeva.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/color_divider</item>
        <item name="cardBackgroundColor">@color/color_bg_card</item>
    </style>

    <!-- Chip Styles -->
    <style name="Widget.BalodSeva.Chip.Category" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/selector_chip_bg</item>
        <item name="android:textColor">@color/selector_chip_text</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <!-- Text Styles -->
    <style name="TextAppearance.BalodSeva.HeadlineLarge">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.BalodSeva.HeadlineMedium">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.BalodSeva.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.BalodSeva.BodyLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <style name="TextAppearance.BalodSeva.Label">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>
</resources>
